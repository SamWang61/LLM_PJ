* text=auto
*.md text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.png binary
*.jpg binary
*.pdf filter=lfs diff=lfs merge=lfs -text
*.mp4 binary
*.zip binary

# Preserve synchronized documents byte for byte.
*.md -text !eol
*.txt -text !eol
*.rst -text !eol
*.csv -text !eol
