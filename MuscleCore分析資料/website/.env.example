FLASK_ENV=development
SECRET_KEY=change-me-before-production
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=musclecore
# Optional: OpenAI-compatible API for future LLM enhancement
LLM_API_KEY=
LLM_MODEL=


# Keep legacy by default. v4 requires an explicitly prepared v4 database.
DATA_MODE=legacy
ENABLE_CHECKOUT=false
# Optional AI: install requirements-ai.txt; preload BGE locally before enabling.
AI_RECOMMENDATIONS_ENABLED=false
BGE_MODEL=BAAI/bge-small-zh-v1.5
AI_SUMMARY_ENABLED=false
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
# Keep telemetry off unless explicitly configured for a training environment.
LANGSMITH_TRACING=false
